{
	"$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
	"extends": [
		"@wxn0brp/biome"
	],
	"files": {
		"includes": [
			"src/**/*",
			"effects/niva-axis-effect/src/**/*"
		]
	},
	"linter": {
		"rules": {
			"complexity": {
